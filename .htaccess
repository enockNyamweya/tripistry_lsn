# Protect sensitive environment and configuration files from web access
<FilesMatch "^\.env|^\.git|^\.htaccess|composer\.json|package\.json|schema\.sql">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory browsing
Options -Indexes
